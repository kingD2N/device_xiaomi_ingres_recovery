# ------------------------------------------------------------------------------
# HAL vibrator qcom open source (IVibrator/default) -- pola OrangeFox-For-Marble.
# Binary & library DIBUILD DARI SOURCE vendor/qcom/opensource/vibrator saat build
# (lihat BoardConfig.mk), lalu di-relink TWRP ke /system/bin dan /system/lib64.
# Workflow menambahkan nama input "awinic_haptic"/"aw8697_haptic" (motor ingres).
# Kalau binary tidak ikut terbuild / gagal start, recovery otomatis memakai
# HAL Xiaomi (vibratorfeature) -- getar tetap jalan.
# ------------------------------------------------------------------------------
service vendor.qti.vibrator /system/bin/vendor.qti.hardware.vibrator.service
    class hal
    user root
    group root input
    setenv LD_LIBRARY_PATH /system/lib64:/vendor/lib64:/vendor/lib64/hw:/sbin
    disabled
    oneshot
    seclabel u:r:recovery:s0

on boot
    start vendor.qti.vibrator
