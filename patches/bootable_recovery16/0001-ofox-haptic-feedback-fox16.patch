+// [ofox-haptics] Getaran saat daftar di-scroll, meniru build OrangeFox fox_16.0 ctapchuk:
+// compose(LOW_TICK) dengan skala 0.35 + 0.55*v^2 (v = kecepatan 0..1), tick awal gesture skala 0.4,
+// jeda minimal 40 ms. HAL tanpa compose: perform(CLICK) dengan 3 tingkat kekuatan yang mendekati skala itu.
+// Hanya jalan kalau HAL punya efek dan efek tab Button aktif (strength bukan Disabled).
+// speedPct = jarak scroll per event/frame dalam persen tinggi satu item; -1 = awal gesture scroll.
+void DataManager::ScrollHaptic(int speedPct)
+{
+#ifndef TW_NO_HAPTICS
+	if (GetIntValue("of_use_haptic_effects") != 1 || GetIntValue("of_button_haptic_enable") != 1)
+		return;
+	if (GetIntValue("of_button_haptic_strength") < 0 || GetIntValue("of_haptic_test_page") == 1)
+		return;
+
+	static struct timespec last = {0, 0};
+	struct timespec now;
+	clock_gettime(CLOCK_MONOTONIC, &now);
+	long long elapsed_ms = (now.tv_sec - last.tv_sec) * 1000LL + (now.tv_nsec - last.tv_nsec) / 1000000LL;
+	if (elapsed_ms < 40)
+		return;  // maksimal ~25 tick per detik
+	last = now;
+
+	float v = speedPct < 0 ? 0.0f : (speedPct > 100 ? 1.0f : speedPct / 100.0f);
+	float scale = speedPct < 0 ? 0.4f : 0.35f + 0.55f * v * v;
+	if (vibrate_compose_primitive(8 /* CompositePrimitive::LOW_TICK */, scale) == 0)
+		return;
+
+	// fallback tanpa compose: skala < 0.5 -> Light, < 0.75 -> Medium, sisanya Strong
+	int strength = 0;  // EffectStrength::LIGHT
+	if (speedPct >= 85)
+		strength = 2;  // STRONG
+	else if (speedPct >= 52)
+		strength = 1;  // MEDIUM
+	vibrate_effect(0 /* Effect::CLICK */, strength);
+#endif
+}
