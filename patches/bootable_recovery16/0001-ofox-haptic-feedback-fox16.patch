+/* [ofox-haptics] Efek haptic AIDL: IVibrator::perform() untuk Click/Tick/Pop/...,
+ * compose() untuk primitive. HAL dicek saat runtime; kalau tidak mendukung efek,
+ * semua fungsi mengembalikan -1 dan pemanggil kembali ke vibrate(durasi). */
+#if !defined(TW_NO_HAPTICS) && defined(USE_QTI_AIDL_HAPTICS)
+#include <android/binder_ibinder.h>
+#include <algorithm>
+#include <mutex>
+#include <vector>
+using ::aidl::android::hardware::vibrator::CompositeEffect;
+using ::aidl::android::hardware::vibrator::CompositePrimitive;
+using ::aidl::android::hardware::vibrator::Effect;
+using ::aidl::android::hardware::vibrator::EffectStrength;
+
+static std::mutex haptic_lock;
+static std::shared_ptr<IVibrator> haptic_vib;
+static std::string haptic_vib_name;
+static int haptic_state = -1;  // -1 belum dicek, 0 tidak didukung, 1 didukung
+static int32_t haptic_caps = 0;
+static std::vector<Effect> haptic_effects;
+static std::vector<CompositePrimitive> haptic_primitives;
+
+// Panggil dengan haptic_lock terkunci. Tidak memblok: kalau HAL belum terdaftar, kembali nullptr.
+static std::shared_ptr<IVibrator> haptic_get_vib_locked() {
+    const std::string name = haptic_pick_instance();
+    if (haptic_vib != nullptr) {
+        // HAL restart, atau HAL qcom baru muncul setelah HAL lain: cek ulang kemampuannya
+        if (name == haptic_vib_name && AIBinder_isAlive(haptic_vib->asBinder().get())) return haptic_vib;
+        haptic_vib = nullptr;
+        haptic_state = -1;
+    }
+    ndk::SpAIBinder binder(AServiceManager_checkService(name.c_str()));
+    if (binder.get() == nullptr) return nullptr;
+    haptic_vib = IVibrator::fromBinder(binder);
+    haptic_vib_name = name;
+    return haptic_vib;
+}
+
+static void haptic_probe_locked() {
+    // haptic_get_vib_locked() me-reset haptic_state kalau HAL berganti/restart
+    std::shared_ptr<IVibrator> vib = haptic_get_vib_locked();
+    if (vib == nullptr) return;  // HAL belum jalan, dicoba lagi di panggilan berikutnya
+    if (haptic_state != -1) return;  // HAL ini sudah dicek
+
+    int32_t caps = 0;
+    if (!vib->getCapabilities(&caps).isOk()) caps = 0;
+    std::vector<Effect> effects;
+    if (!vib->getSupportedEffects(&effects).isOk()) effects.clear();
+    std::vector<CompositePrimitive> prims;
+    if ((caps & IVibrator::CAP_COMPOSE_EFFECTS) && !vib->getSupportedPrimitives(&prims).isOk())
+        prims.clear();
+
+    haptic_caps = caps;
+    haptic_effects = effects;
+    haptic_primitives = prims;
+    haptic_state = effects.empty() ? 0 : 1;
+
+    std::string e, p;
+    for (auto x : effects) e += std::to_string(static_cast<int>(x)) + " ";
+    for (auto x : prims) p += std::to_string(static_cast<int>(x)) + " ";
+    printf("I:[ofox-haptics] %s caps=0x%x effects=[ %s] primitives=[ %s] -> %s\n",
+           haptic_vib_name.c_str(), caps, e.c_str(), p.c_str(),
+           haptic_state == 1 ? "effects ON" : "effects OFF");
+}
+
+static void haptic_schedule_off(std::shared_ptr<IVibrator> vib, int ms) {
+#ifdef USE_QTI_AIDL_HAPTICS_FIX_OFF
+    // HAL ini tidak selalu mematikan motor sendiri (lihat vibrate() di atas)
+    if (ms <= 0 || ms > 5000) ms = 50;
+    vib_on_count++;
+    std::thread([vib, ms] {
+        usleep((ms + 10) * 1000);
+        vib_on_count--;
+        if (!vib_on_count) (void)vib->off();
+    }).detach();
+#else
+    (void)vib;
+    (void)ms;
+#endif
+}
+
+int haptic_effects_supported(void) {
+    std::lock_guard<std::mutex> l(haptic_lock);
+    haptic_probe_locked();
+    return haptic_state == 1 ? 1 : 0;
+}
+
+int vibrate_effect(int effect, int strength) {
+    std::shared_ptr<IVibrator> vib;
+    {
+        std::lock_guard<std::mutex> l(haptic_lock);
+        haptic_probe_locked();
+        if (haptic_state != 1 || haptic_vib == nullptr) return -1;
+        Effect e = static_cast<Effect>(effect);
+        if (std::find(haptic_effects.begin(), haptic_effects.end(), e) == haptic_effects.end())
+            return -1;
+        vib = haptic_vib;
+    }
+    if (strength < 0) strength = 0;
+    if (strength > 2) strength = 2;
+    int32_t dur = 0;
+    if (!vib->perform(static_cast<Effect>(effect), static_cast<EffectStrength>(strength), nullptr, &dur).isOk())
+        return -1;
+    haptic_schedule_off(vib, dur);
+    return 0;
+}
+
+static CompositeEffect haptic_step(CompositePrimitive p, float scale, int delay_ms) {
+    CompositeEffect c;
+    c.delayMs = delay_ms;
+    c.primitive = p;
+    c.scale = scale;
+    return c;
+}
+
+static int haptic_compose(const std::vector<CompositeEffect>& comp) {
+    std::shared_ptr<IVibrator> vib;
+    {
+        std::lock_guard<std::mutex> l(haptic_lock);
+        haptic_probe_locked();
+        if (haptic_vib == nullptr || !(haptic_caps & IVibrator::CAP_COMPOSE_EFFECTS)) return -1;
+        for (const auto& c : comp) {
+            if (std::find(haptic_primitives.begin(), haptic_primitives.end(), c.primitive) ==
+                haptic_primitives.end())
+                return -1;
+        }
+        vib = haptic_vib;
+    }
+    if (!vib->compose(comp, nullptr).isOk()) return -1;
+    int total = 0;
+    for (const auto& c : comp) {
+        int32_t d = 0;
+        if (!vib->getPrimitiveDuration(c.primitive, &d).isOk()) d = 20;
+        total += c.delayMs + d;
+    }
+    haptic_schedule_off(vib, total);
+    return 0;
+}
+
+int vibrate_primitive(int primitive) {
+    return vibrate_compose_primitive(primitive, 1.0f);
+}
+
+int vibrate_compose_primitive(int primitive, float scale) {
+    if (primitive < 1 || primitive > static_cast<int>(CompositePrimitive::LOW_TICK)) return -1;
+    if (scale < 0.0f) scale = 0.0f;
+    if (scale > 1.0f) scale = 1.0f;
+    return haptic_compose({haptic_step(static_cast<CompositePrimitive>(primitive), scale, 0)});
+}
+
+int vibrate_compose_pattern(const char* name) {
+    const std::string n = name ? name : "";
+    std::vector<CompositeEffect> c;
+    if (n == "success") {
+        c = {haptic_step(CompositePrimitive::CLICK, 0.5f, 0),
+             haptic_step(CompositePrimitive::CLICK, 1.0f, 100)};
+    } else if (n == "warning") {
+        c = {haptic_step(CompositePrimitive::CLICK, 1.0f, 0),
+             haptic_step(CompositePrimitive::CLICK, 0.5f, 100)};
+    } else if (n == "error") {
+        c = {haptic_step(CompositePrimitive::CLICK, 0.6f, 0),
+             haptic_step(CompositePrimitive::CLICK, 0.6f, 80),
+             haptic_step(CompositePrimitive::CLICK, 1.0f, 80),
+             haptic_step(CompositePrimitive::CLICK, 0.6f, 80)};
+    } else {
+        return -1;
+    }
+    if (haptic_compose(c) == 0) return 0;
+    // HAL tanpa compose: pakai efek bawaan yang paling mirip
+    if (n == "success") return vibrate_effect(static_cast<int>(Effect::DOUBLE_CLICK), 2);
+    if (n == "warning") return vibrate_effect(static_cast<int>(Effect::HEAVY_CLICK), 1);
+    return vibrate_effect(static_cast<int>(Effect::THUD), 2);
+}
+#else
+int haptic_effects_supported(void) { return 0; }
+int vibrate_effect(int, int) { return -1; }
+int vibrate_primitive(int) { return -1; }
+int vibrate_compose_pattern(const char*) { return -1; }
+int vibrate_compose_primitive(int, float) { return -1; }
+#endif
